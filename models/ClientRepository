<?php
class ClientRepository {
    private PDO $pdo;

    public function __construct(PDO $pdo) {
        $this->pdo = $pdo;
    }

    public function findAll(int $limit, int $offset, string $orderBy = 'last_name', string $direction = 'ASC', string $search = ''): array {
        $sql = "SELECT * FROM clients";
        $conditions = [];
        $params = [];
        if ($search) {
            $conditions[] = "(last_name LIKE :search OR first_name LIKE :search2 OR phone LIKE :search3 OR email LIKE :search4)";
            $s = "%$search%";
            $params['search'] = $s;
            $params['search2'] = $s;
            $params['search3'] = $s;
            $params['search4'] = $s;
        }
        if ($conditions) {
            $sql .= " WHERE " . implode(" AND ", $conditions);
        }
        $sql .= " ORDER BY $orderBy $direction LIMIT :limit OFFSET :offset";
        $stmt = $this->pdo->prepare($sql);
        foreach ($params as $key => $val) {
            $stmt->bindValue(":$key", $val);
        }
        $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
        $stmt->bindValue(':offset', $offset, PDO::PARAM_INT);
        $stmt->execute();
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    public function count(string $search = ''): int {
        $sql = "SELECT COUNT(*) FROM clients";
        $params = [];
        if ($search) {
            $sql .= " WHERE last_name LIKE :search OR first_name LIKE :search2 OR phone LIKE :search3 OR email LIKE :search4";
            $s = "%$search%";
            $params['search'] = $s;
            $params['search2'] = $s;
            $params['search3'] = $s;
            $params['search4'] = $s;
        }
        $stmt = $this->pdo->prepare($sql);
        foreach ($params as $key => $val) {
            $stmt->bindValue(":$key", $val);
        }
        $stmt->execute();
        return $stmt->fetchColumn();
    }

    public function findById(int $id): ?array {
        $stmt = $this->pdo->prepare("SELECT * FROM clients WHERE client_id = :id");
        $stmt->execute(['id' => $id]);
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        return $row ?: null;
    }

    public function create(array $data): int {
        $stmt = $this->pdo->prepare("INSERT INTO clients (last_name, first_name, phone, email) VALUES (:ln, :fn, :ph, :em)");
        $stmt->execute([
            'ln' => $data['last_name'],
            'fn' => $data['first_name'],
            'ph' => $data['phone'],
            'em' => $data['email']
        ]);
        return $this->pdo->lastInsertId();
    }

    public function update(int $id, array $data): bool {
        $stmt = $this->pdo->prepare("UPDATE clients SET last_name=:ln, first_name=:fn, phone=:ph, email=:em WHERE client_id=:id");
        return $stmt->execute([
            'ln' => $data['last_name'],
            'fn' => $data['first_name'],
            'ph' => $data['phone'],
            'em' => $data['email'],
            'id' => $id
        ]);
    }

    public function delete(int $id): bool {
        // Проверка на наличие связанных просмотров
        $check = $this->pdo->prepare("SELECT COUNT(*) FROM viewings WHERE client_id = :id");
        $check->execute(['id' => $id]);
        if ($check->fetchColumn() > 0) {
            return false; // Удаление запрещено
        }
        $stmt = $this->pdo->prepare("DELETE FROM clients WHERE client_id = :id");
        return $stmt->execute(['id' => $id]);
    }
}
